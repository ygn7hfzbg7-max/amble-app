VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Email notifications (serverless functions in /api only — never exposed
# to the browser, so these are deliberately NOT prefixed with VITE_) ---

# Resend API key. In Vercel this is already set as a Production env var.
RESEND_API_KEY=

# Optional: "Name <address@yourdomain.com>". Defaults to a placeholder
# amble.app address — set this once you've verified a sending domain in
# Resend, otherwise sends will fail or land in spam.
RESEND_FROM_EMAIL=

# Service-role key from Supabase Project Settings > API. Required so the
# webhook handler can look up recipient emails and notifications_enabled
# across RLS. Keep this out of the client bundle — it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed domain, e.g. https://amble.vercel.app — used to build the
# links inside notification emails. Falls back to Vercel's automatic
# VERCEL_URL if unset, but that changes per-deployment on preview builds,
# so set this explicitly for production.
PUBLIC_APP_URL=

# Optional shared secret. When set, /api/send-notification requires a
# matching `x-webhook-secret` header — configure the same value as a custom
# header on each Supabase Database Webhook so random requests can't trigger
# emails.
SUPABASE_WEBHOOK_SECRET=

# Optional shared secret for the review-reminders cron endpoint. When set,
# Vercel automatically sends it as `Authorization: Bearer <value>` on cron
# invocations — see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs
CRON_SECRET=
